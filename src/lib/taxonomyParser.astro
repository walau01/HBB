---
import { getPosts, normalizeLang } from "@/lib/journal";
import { slugify } from "@/lib/utils/textConverter";

// Use the same publication policy as the blog; private drafts never create tag pages.
export const getAllTaxonomy = async (lang: string) =>
  (await getPosts(normalizeLang(lang))).flatMap((post) =>
    post.tags.map(slugify),
  );
export const getTaxonomy = async (lang: string) => [
  ...new Set(await getAllTaxonomy(lang)),
];
---
