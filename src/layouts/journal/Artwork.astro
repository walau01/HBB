---
import { getCopy, type Lang } from '@/lib/journal';
const { lang = 'en', motif = 'costs', compact = false } = Astro.props as { lang: Lang; motif: string; compact?: boolean };
const c = await getCopy(lang);
---
<div class:list={['artwork', `art-${motif}`, { compact }]} aria-hidden="true">
  {motif === 'costs' ? <>
    <div class="art-kicker">{c.artwork.costKicker}</div>
    <div class="art-statement"><span>{c.featureArt1}</span><em>{c.featureArt2}</em></div>
    <div class="art-cost-lines"><span></span><span></span><span></span></div>
    <div class="art-foot">{c.artFoot}</div>
    <span class="art-index">01</span>
  </> : motif === 'ath' ? <>
    <div class="art-kicker">{c.artwork.bridgeKicker}</div>
    <div class="ath-type">{c.artwork.all}<br/>{c.artwork.time}<br/><em>{c.artwork.high}</em></div>
    <div class="art-foot">{c.artwork.priceFoot}</div>
  </> : motif === 'factor' ? <>
    <div class="art-kicker">{c.artwork.factorKicker}</div>
    <div class="factor-type">α ≠<br/><em>{c.artwork.factorTitle}</em></div>
    <div class="art-foot">{c.artwork.factorFoot}</div>
  </> : motif === 'etf' ? <>
    <div class="art-kicker">{c.artwork.etfKicker}</div>
    <div class="etf-type">E<span>T</span>F</div>
    <div class="art-foot">{c.artwork.etfFoot}</div>
  </> : <>
    <div class="art-kicker">{c.artwork.lifeKicker}</div>
    <div class="life-type">{c.artwork.make}<br/><em>{c.artwork.room}</em></div>
    <div class="art-foot">{c.artwork.lifeFoot}</div>
  </>}
</div>
