---
import Base from "@/layouts/Base.astro";
import PostCard from "./PostCard.astro";
import { getCopy, url, getPosts, type Lang } from "@/lib/journal";
const { lang } = Astro.props as { lang: Lang };
const posts = await getPosts(lang);
const c = await getCopy(lang);
const recentPosts = [...posts]
  .sort(
    (a, b) =>
      (b.entry.data.date?.getTime() || 0) - (a.entry.data.date?.getTime() || 0),
  )
  .slice(0, 3);
import { getTranslations } from "@/lib/utils/languageParser";
const { simpleCoast: u } = await getTranslations(lang);
---

<Base lang={lang}>
  <div class="container simple-home">
    <section class="intent-home">
      <h1>{u.homeTitle}</h1><p>{u.homeIntro}</p>
      <nav class="intent-paths" aria-label={c.menu}>
        {
          u.paths.map((path: string[], i: number) => (
            <a href={url(lang, ["start-here", "blog", "coast-fire"][i])}>
              <>
                <h2>{path[0]}</h2>
                <span>{path[1]}</span>
              </>
            </a>
          ))
        }
      </nav>
    </section>
    <section class="simple-articles" aria-labelledby="recent-title">
      <div class="section-header">
        <div><h2 id="recent-title">{u.latest}</h2><p>{c.recentIntro}</p></div><a
          class="text-link"
          href={url(lang, "blog")}>{c.all} →</a
        >
      </div>
      <div class="post-grid">
        {
          recentPosts.map((post) => (
            <PostCard post={post} lang={lang} showArt={false} />
          ))
        }
      </div>
    </section>
  </div>
</Base>
