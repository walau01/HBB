---
import Base from "@/layouts/Base.astro";
import ArticleBoard from "@/layouts/components/ArticleBoard.astro";
import OrderChit from "@/layouts/components/OrderChit.astro";
import QuestionBanner from "@/layouts/components/QuestionBanner.astro";
import TopicsRow from "@/layouts/components/TopicsRow.astro";
import {
  beginnerPath,
  getCopy,
  getPosts,
  groupByTopic,
  pickSlugs,
  url,
  type Lang,
} from "@/lib/journal";
const { lang } = Astro.props as { lang: Lang };
const posts = await getPosts(lang);
const c = await getCopy(lang);
const defaults = pickSlugs(posts, beginnerPath);
const picks = defaults.length === 3 ? defaults : posts.slice(0, 3);
const questions = posts.map((p) => p.title).filter((t) => /[?？]$/.test(t));
---

<Base lang={lang} description={c.intro}>
  <section class="hero">
    <div class="hero-copy">
      <h1 class="hero-heading">
        <span class="hero-brand" data-neon>WALAU<span>01</span></span>
        <span class="hero-tagline">{c.taglineA} <mark>{c.taglineB}</mark></span>
      </h1>
      <p class="hero-intro">{c.intro}</p>
      <div class="button-row">
        <a class="btn btn-primary" href="#topics"
          >{c.exploreTopics} <span aria-hidden="true">→</span></a
        >
        <a class="btn btn-secondary" href={url(lang, "about")}
          >{c.aboutAuthor}</a
        >
      </div>
    </div>
    <OrderChit
      class="hero-chit"
      lang={lang}
      copy={c}
      title={c.chitTitle}
      picks={picks}
      pool={posts}
      note={c.chitNote}
    />
  </section>

  <TopicsRow id="topics" lang={lang} copy={c} posts={posts} />

  {questions.length > 0 && <QuestionBanner questions={questions} />}

  <div class="page-wide">
    <ArticleBoard
      id="articles"
      lang={lang}
      copy={c}
      title={c.boardTitle}
      description={c.boardText}
      footnote={posts.some((p) => p.sample) ? c.boardNote : undefined}
      groups={groupByTopic(posts)}
    />
  </div>

  <section class="about-strip page-narrow" aria-labelledby="about-title">
    <span class="monogram" aria-hidden="true">w.</span>
    <div>
      <h2 id="about-title">{c.aboutTitle}</h2>
      <p>{c.authorBio}</p>
      <a class="text-link" href={url(lang, "about")}>{c.aboutLink}</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    max-width: 1320px;
    margin-inline: auto;
    padding: 56px 40px 72px;
  }
  .hero-copy {
    flex: 1 1 600px;
    min-width: 0;
  }
  .hero-heading {
    margin: 0;
    font-weight: 400;
  }
  .hero-brand {
    display: block;
    color: var(--red-text);
    font:
      400 clamp(88px, 16vw, 210px) / 0.86 var(--font-secondary),
      sans-serif;
    letter-spacing: -0.01em;
  }
  .hero-brand span {
    color: var(--mustard);
    -webkit-text-stroke: 2px var(--red-text);
  }
  :global([data-theme="dark"]) .hero-brand {
    color: #ffe9e4;
    text-shadow: var(--glow-red-big);
  }
  :global([data-theme="dark"]) .hero-brand span {
    color: var(--color-neon-gold);
    -webkit-text-stroke: 0;
    text-shadow: var(--glow-gold);
  }
  .hero-tagline {
    display: block;
    margin-top: 20px;
    color: var(--ink);
    font: 400 clamp(30px, 3.8vw, 54px) / 1.15 var(--display);
    text-transform: uppercase;
  }
  :global(:lang(zh)) .hero-tagline {
    font-weight: 900;
  }
  .hero-tagline mark {
    display: inline-block;
    padding: 0 10px;
    background: var(--mustard);
    color: var(--mustard-ink);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  :global([data-theme="dark"]) .hero-tagline mark {
    background: transparent;
    color: var(--color-neon-gold);
    box-shadow:
      inset 0 0 0 3px var(--color-neon-gold-glow),
      0 0 14px rgb(255 194 46 / 0.6);
  }
  .hero-intro {
    max-width: 560px;
    margin: 26px 0 32px;
    color: var(--secondary);
    font-size: 20px;
    line-height: 1.55;
  }
  .hero :global(.hero-chit) {
    flex: 0 1 420px;
    min-width: 300px;
  }
  .about-strip {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 80px;
  }
  .about-strip h2 {
    font: 400 40px/1.1 var(--display);
    text-transform: uppercase;
  }
  :global(:lang(zh)) .about-strip h2 {
    font-weight: 900;
  }
  .about-strip p {
    max-width: 52ch;
    margin: 8px 0 12px;
    color: var(--secondary);
    font-size: 18px;
  }
  @media (max-width: 700px) {
    .hero {
      padding: 32px 20px 48px;
      gap: 40px;
    }
    .hero-brand {
      font-size: 25vw;
    }
    .hero :global(.hero-chit) {
      min-width: 0;
      flex-basis: 100%;
      padding-inline: 4px;
    }
    .about-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
