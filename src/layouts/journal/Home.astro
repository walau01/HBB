---
import Base from "@/layouts/Base.astro";
import PostCard from "./PostCard.astro";
import { getCopy, url, getPosts, topics, type Lang } from "@/lib/journal";
const { lang } = Astro.props as { lang: Lang };
const posts = await getPosts(lang);
const c = await getCopy(lang);
// Finished articles lead; clearly labelled samples remain available until publication.
const recentPosts = [...posts]
  .sort(
    (a, b) =>
      Number(a.sample) - Number(b.sample) ||
      (b.entry.data.date?.getTime() || 0) -
        (a.entry.data.date?.getTime() || 0) ||
      a.order - b.order,
  )
  .slice(0, 6);
---

<Base lang={lang} description={c.intro}>
  <div class="container blog-home">
    <section class="blog-intro" aria-labelledby="home-heading">
      <div class="intro-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 id="home-heading">{c.headline}</h1>
        <p class="intro-description">{c.intro}</p>
        <a class="button-primary" href={url(lang, "blog")}
          >{c.browse}<span aria-hidden="true">→</span></a
        >
      </div>
      <aside class="reading-guide">
        <p class="eyebrow">{c.guide.welcomeTitle}</p>
        <h2>{c.guide.homeTitle}</h2>
        <p>{c.guide.welcomeText}</p>
        <a class="text-link" href={url(lang, "start-here")}
          >{c.guide.link}<span aria-hidden="true"> →</span></a
        >
      </aside>
    </section>
    <nav class="topic-strip" aria-label={c.filterLabel}>
      <span>{c.exploreTopics}</span>
      {
        topics.map((topic) => (
          <a href={url(lang, `topics/${topic}`)}>
            {c.topics[topic].title}
            <span aria-hidden="true"> ↗</span>
          </a>
        ))
      }
    </nav>
    <section class="home-articles" aria-labelledby="recent-title">
      <div class="section-header">
        <div>
          <p class="eyebrow">{c.notebook}</p><h2 id="recent-title">
            {c.recent}
          </h2>
        </div>
        <a class="text-link" href={url(lang, "blog")}
          >{c.all}<span aria-hidden="true"> →</span></a
        >
      </div>
      <div class="post-grid">
        {recentPosts.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
    </section>
  </div>
</Base>
