---
// Start here: the order chit expanded into a page, with a fixed beginner path.
import Base from "@/layouts/Base.astro";
import OrderChit from "@/layouts/components/OrderChit.astro";
import TopicsRow from "@/layouts/components/TopicsRow.astro";
import {
  beginnerPath,
  getCopy,
  getPosts,
  pickSlugs,
  type Lang,
} from "@/lib/journal";
const { lang } = Astro.props as { lang: Lang };
const c = await getCopy(lang);
const posts = await getPosts(lang);
const steps = pickSlugs(posts, beginnerPath);
---

<Base
  lang={lang}
  title={c.startTitle}
  description={c.startIntro}
  active="foundation"
  currentPath="start-here"
>
  <div class="start-page">
    <OrderChit
      class="start-chit"
      lang={lang}
      copy={c}
      title={c.chitTitle}
      titleTag="h1"
      intro={c.startIntro}
      picks={steps}
      why={c.startWhy}
      button={false}
    />
  </div>
  <TopicsRow lang={lang} copy={c} posts={posts} size="S" label={c.startAfter} />
</Base>

<style>
  .start-page {
    max-width: 640px;
    margin: 0 auto;
    padding: 72px 24px 80px;
  }
  .start-page :global(.chit-title) {
    font-size: 18px;
  }
  .start-page :global(.chit-list) {
    gap: 22px;
  }
  .start-page :global(.chit-body > a:first-child) {
    font-weight: 600;
    font-size: 16px;
  }
  @media (max-width: 600px) {
    .start-page {
      padding: 56px 12px 56px;
    }
  }
</style>
