---
// All articles (/blog): the board with every article grouped by topic, plus
// a topic filter, search and tags. Also used for /tags/<tag> (a flat list
// with topic badges).
import Base from "@/layouts/Base.astro";
import ArticleBoard from "@/layouts/components/ArticleBoard.astro";
import PriceTag from "@/layouts/components/PriceTag.astro";
import Signboard from "@/layouts/components/Signboard.astro";
import Icon from "./Icon.astro";
import config from "@/config/config.json";
import {
  countText,
  getCopy,
  getPosts,
  groupByTopic,
  tagCounts,
  url,
  type Lang,
  type Post,
} from "@/lib/journal";
import { topicList } from "@/lib/topics";

interface Props {
  lang: Lang;
  /** A tag page: only these posts, as a flat list. */
  tag?: { slug: string; label: string; posts: Post[] };
}
const { lang, tag } = Astro.props;
const c = await getCopy(lang);
const allPosts = await getPosts(lang);
const posts = tag ? tag.posts : allPosts;
const title = tag ? c.tagPageTitle.replace("{tag}", tag.label) : c.boardTitle;
const intro = tag ? c.tagPageText.replace("{tag}", tag.label) : c.boardText;
const path = tag ? `tags/${tag.slug}` : "blog";
const pageURL = new URL(url(lang, path), config.site.base_url).href;
const published = posts.filter((p) => !p.sample);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  url: pageURL,
  description: intro,
  inLanguage: lang === "zh" ? "zh-Hans" : lang,
  isPartOf: { "@id": `${new URL("/", config.site.base_url).href}#website` },
  ...(published.length
    ? {
        mainEntity: {
          "@type": "ItemList",
          itemListElement: published.map((p, i) => ({
            "@type": "ListItem",
            position: i + 1,
            url: new URL(url(lang, `blog/${p.slug}`), config.site.base_url)
              .href,
            name: p.title,
          })),
        },
      }
    : {}),
};
// Old /blog?category=… bookmarks → the matching topic page.
const legacy = Object.fromEntries(
  [
    ["foundation", "investing-101"],
    ["research", "beneath-the-surface"],
    ["bridge", "beneath-the-surface"],
    ["questions", "beneath-the-surface"],
    ["life", "off-the-clock"],
  ].map(([from, to]) => [from, url(lang, `topics/${to}`)]),
);
---

<Base
  lang={lang}
  title={title}
  description={intro}
  active="articles"
  currentPath={path}
  noindex={!published.length}
  structuredData={structuredData}
>
  {
    !tag && (
      <script is:inline define:vars={{ legacy }}>
        const category = new URLSearchParams(location.search).get("category");
        if (category && legacy[category]) location.replace(legacy[category]);
      </script>
    )
  }
  <div class="page-wide archive-page">
    <ArticleBoard
      lang={lang}
      copy={c}
      title={title}
      titleTag="h1"
      description={intro}
      groups={tag ? undefined : groupByTopic(posts)}
      posts={tag ? posts : undefined}
      badges={!!tag}
      footnote={!tag && posts.some((p) => p.sample) ? c.boardNote : undefined}
      id="all-articles"
    >
      {
        !tag && (
          <div class="archive-controls" slot="controls">
            <nav
              class="archive-topics"
              aria-label={c.filterLabel}
              data-topic-filter
            >
              <a
                class="archive-all"
                href={url(lang, "blog")}
                aria-current="page"
                data-topic=""
              >
                {c.tagAll}
              </a>
              {topicList.map((t) => (
                <Signboard
                  topic={t}
                  lang={lang}
                  size="S"
                  href={url(lang, `topics/${t.id}`)}
                  class="archive-topic"
                />
              ))}
            </nav>
            <div class="archive-search">
              <label for="archive-search">{c.search}</label>
              <div class="archive-search-field">
                <Icon name="search" />
                <input
                  type="search"
                  id="archive-search"
                  placeholder={c.searchPlaceholder}
                  autocomplete="off"
                />
                <button
                  class="icon-button"
                  type="button"
                  data-clear-search
                  aria-label={c.clearSearch}
                  hidden
                >
                  <Icon name="close" />
                </button>
              </div>
            </div>
            <nav class="archive-tags" aria-label={c.tagsTitle}>
              {tagCounts(posts).map((t) => (
                <PriceTag text={t.label} href={url(lang, `tags/${t.slug}`)} />
              ))}
            </nav>
            <p class="archive-count" role="status">
              <span
                data-result-count
                data-many={c.resultsCount}
                data-one={c.resultsCountOne}
              >
                {countText(posts.length, c.resultsCount, c.resultsCountOne)}
              </span>
            </p>
          </div>
        )
      }
      <div class="archive-empty" data-archive-empty hidden>
        <p>{c.searchEmpty}</p>
        <button class="btn btn-secondary" type="button" data-reset-search>
          {c.clearSearch}
        </button>
      </div>
    </ArticleBoard>
  </div>
</Base>

<script>
  import { matchesSearch } from "@/lib/search";
  const items = document.querySelectorAll<HTMLElement>("[data-board-item]");
  const groups = document.querySelectorAll<HTMLElement>("[data-board-group]");
  const input = document.querySelector<HTMLInputElement>("#archive-search");
  const clear = document.querySelector<HTMLButtonElement>(
    "[data-clear-search]",
  );
  const filter = document.querySelector<HTMLElement>("[data-topic-filter]");
  const counter = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-archive-empty]");
  let topic = "";

  if (input) input.value = new URLSearchParams(location.search).get("q") || "";

  function update() {
    let count = 0;
    items.forEach((item) => {
      const shown =
        (!topic || item.dataset.topic === topic) &&
        matchesSearch(item.dataset.search || "", input?.value || "");
      item.hidden = !shown;
      if (shown) count++;
    });
    groups.forEach((group) => {
      group.hidden = !group.querySelector("[data-board-item]:not([hidden])");
    });
    if (counter)
      counter.textContent =
        count === 1
          ? counter.dataset.one || ""
          : (counter.dataset.many || "").replace("{n}", String(count));
    if (empty) empty.hidden = count > 0;
    if (clear) clear.hidden = !input?.value;
  }
  function syncURL() {
    const next = new URL(location.href);
    const query = input?.value.trim();
    if (query) next.searchParams.set("q", query);
    else next.searchParams.delete("q");
    history.replaceState(null, "", next);
  }
  function setTopic(next: string, link?: Element) {
    topic = next;
    filter?.querySelectorAll("a").forEach((a) => {
      if (a === link) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
    update();
  }
  // Topic signs are links to the topic pages; with JavaScript they filter
  // this list instead (Ctrl/⌘-click still opens the topic page).
  filter?.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement).closest("a");
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const id =
      link.dataset.topic ?? link.getAttribute("href")?.split("/").pop();
    setTopic(id || "", link);
  });
  input?.addEventListener("input", () => {
    syncURL();
    update();
  });
  function reset() {
    if (input) input.value = "";
    syncURL();
    setTopic("", filter?.querySelector(".archive-all") || undefined);
    input?.focus();
  }
  clear?.addEventListener("click", reset);
  document
    .querySelector("[data-reset-search]")
    ?.addEventListener("click", reset);
  update();
</script>

<style>
  .archive-page {
    padding-top: 48px;
  }
  .archive-controls {
    display: grid;
    gap: 22px;
    max-width: 920px;
    margin: 32px auto 0;
  }
  .archive-topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
  }
  .archive-all {
    display: grid;
    place-items: center;
    min-width: 72px;
    height: 57px;
    padding: 0 16px;
    border: 2px solid var(--board-dash);
    color: var(--board-ink);
    font: 600 14px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .archive-all[aria-current] {
    border-color: var(--board-gold);
    background: var(--board-gold);
    color: #1c1712;
  }
  .archive-topics :global(.archive-topic) {
    border-radius: 4px;
    outline-offset: 4px;
  }
  .archive-topics :global(.archive-topic[aria-current]) {
    outline: 3px solid var(--board-gold);
  }
  .archive-search {
    display: grid;
    gap: 8px;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
  }
  .archive-search label {
    color: var(--board-soft);
    font: 600 12px/1.4 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .archive-search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 4px 14px;
    background: var(--board-ink);
    color: #1c1712;
    border-radius: 4px;
  }
  .archive-search-field input {
    flex: 1;
    min-width: 0;
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 17px;
    box-shadow: none;
  }
  .archive-search-field input::placeholder {
    color: #6b5f4e;
  }
  .archive-search-field :global(.icon-button:hover) {
    background: rgb(0 0 0 / 0.08);
  }
  .archive-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .archive-count {
    color: var(--board-soft);
    font: 600 13px/1 var(--mono);
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }
  .archive-empty {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 32px 0 8px;
    text-align: center;
    font-size: 18px;
  }
  .archive-empty :global(.btn-secondary) {
    border-color: var(--board-ink);
    color: var(--board-ink);
  }
</style>
