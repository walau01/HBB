---
import Base from "@/layouts/Base.astro";
import PostCard from "./PostCard.astro";
import Icon from "./Icon.astro";
import { getCopy, getPosts, type Lang } from "@/lib/journal";
const { lang } = Astro.props as { lang: Lang };
const posts = await getPosts(lang);
const c = await getCopy(lang);
const categories = [
  { key: "foundation", label: c.categories.foundation },
  { key: "questions", label: c.categories.research },
  { key: "life", label: c.categories.life },
];
---

<Base lang={lang} title={c.articles} active="articles" currentPath="blog">
  <div class="container archive">
    <div class="archive-heading">
      <p class="eyebrow">{c.archiveEyebrow}</p><h1>{c.archiveTitle}</h1><p>
        {c.archiveText}
      </p>
    </div>
    <div class="archive-controls">
      <div class="filter-tabs" role="group" aria-label={c.filterLabel}>
        <button class="active" data-filter="all" aria-pressed="true"
          >{c.filterAll}</button
        >{
          categories.map((cat) => (
            <button data-filter={cat.key} aria-pressed="false">
              {cat.label}
            </button>
          ))
        }
      </div><label class="archive-search"
        ><Icon name="search" /><input
          type="search"
          id="archive-search"
          placeholder={c.searchPlaceholder}
          aria-label={c.search}
        /></label>
    </div>
    <p class="result-count" aria-live="polite">
      <span id="result-count">{posts.length}</span>
      {c.showing}
    </p>
    <div class="post-grid archive-grid">
      {posts.map((p) => <PostCard post={p} lang={lang} showArt={false} />)}
    </div>
    <div id="archive-empty" class="archive-empty" hidden>
      <Icon name="book" size={32} /><p>{c.searchEmpty}</p>
    </div>
  </div>
  <script>
    const buttons =
      document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>(
      ".archive-grid .post-card",
    );
    const input = document.querySelector<HTMLInputElement>("#archive-search");
    const valid = ["all", "questions", "foundation", "life"];
    const requested =
      new URLSearchParams(location.search).get("category") || "all";
    let selected = ["research", "bridge"].includes(requested)
      ? "questions"
      : valid.includes(requested)
        ? requested
        : "all";
    const update = () => {
      let count = 0;
      buttons.forEach((b) => {
        const active = b.dataset.filter === selected;
        b.classList.toggle("active", active);
        b.setAttribute("aria-pressed", String(active));
      });
      cards.forEach((card) => {
        const categoryMatches =
          selected === "all" ||
          card.dataset.category === selected ||
          (selected === "questions" &&
            ["research", "bridge"].includes(card.dataset.category || ""));
        const shown =
          categoryMatches &&
          (card.dataset.search || "").includes(
            input?.value.toLocaleLowerCase().trim() || "",
          );
        card.hidden = !shown;
        if (shown) count++;
      });
      const counter = document.querySelector("#result-count");
      if (counter) counter.textContent = String(count);
      const empty = document.querySelector<HTMLElement>("#archive-empty");
      if (empty) empty.hidden = count > 0;
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        selected = b.dataset.filter || "all";
        const next = new URL(location.href);
        if (selected === "all") next.searchParams.delete("category");
        else next.searchParams.set("category", selected);
        history.replaceState(null, "", next);
        update();
      }),
    );
    input?.addEventListener("input", update);
    update();
  </script>
</Base>
