---
import { getCopy, url, searchText, type Post, type Lang } from "@/lib/journal";
const { post, lang } = Astro.props as { post: Post; lang: Lang };
const c = await getCopy(lang),
  p = post.text[lang];
---

<article
  class="post-card"
  data-category={post.category}
  data-search={searchText(post, c)}
>
  <a class="post-card-link" href={url(lang, `blog/${post.slug}`)}>
    <div class="post-meta">
      <span>{c.categories[post.category]}</span><span
        >{post.minutes} {c.readTime}</span>
    </div>
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <div class="post-card-foot">
      <span class="read-link">{c.read}<span aria-hidden="true"> →</span></span>
      {post.sample && <span class="draft-label">{c.draft}</span>}
    </div>
  </a>
</article>
