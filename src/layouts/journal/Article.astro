---
// Article page: the theme frames the article; the reading area stays calm.
import Base from "@/layouts/Base.astro";
import Awning from "@/layouts/components/Awning.astro";
import PriceTag from "@/layouts/components/PriceTag.astro";
import Signboard from "@/layouts/components/Signboard.astro";
import Stamp from "@/layouts/components/Stamp.astro";
import { render } from "astro:content";
import {
  beginnerPath,
  formatDate,
  getCopy,
  getPosts,
  groupByTopic,
  shortMinutes,
  url,
  type Lang,
  type Post,
} from "@/lib/journal";
import { slugify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

const { lang, post } = Astro.props as { lang: Lang; post: Post };
const c = await getCopy(lang);
const { Content, headings } = await render(post.entry);
const sections = headings.filter((h) => h.depth === 2);
const all = await getPosts(lang);

// Next up: the next beginner step, else the next article in this topic,
// else the first article of the following topic.
const inPath = beginnerPath.indexOf(post.slug);
const groups = groupByTopic(all).filter((g) => g.posts.length);
const groupIndex = groups.findIndex((g) => g.topic.id === post.topic.id);
const siblings = groups[groupIndex]?.posts || [];
const next =
  (inPath >= 0 &&
    inPath < beginnerPath.length - 1 &&
    all.find((p) => p.slug === beginnerPath[inPath + 1])) ||
  (siblings.length > 1 &&
    siblings[(siblings.indexOf(post) + 1) % siblings.length]) ||
  groups[(groupIndex + 1) % groups.length]?.posts[0];

const minutes = c.minRead.replace("{n}", String(post.minutes));
const stampText = c.minReadStamp.replace("{n}", String(post.minutes));
const meta = [
  post.entry.data.author,
  post.date && formatDate(post.date, lang),
  minutes,
].filter(Boolean);

const articleURL = new URL(url(lang, `blog/${post.slug}`), config.site.base_url)
  .href;
const authorURL = new URL(url(lang, "about"), config.site.base_url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleURL}#article`,
  url: articleURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": articleURL },
  headline: post.title,
  description: post.summary,
  inLanguage: lang === "zh" ? "zh-Hans" : lang,
  articleSection: post.topic.name[lang],
  keywords: post.tags.join(", ") || undefined,
  author: {
    "@type": "Person",
    "@id": `${authorURL}#person`,
    name: post.entry.data.author,
    url: authorURL,
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${new URL("/", config.site.base_url).href}#website`,
  },
  ...(post.date ? { datePublished: post.date.toISOString() } : {}),
  ...(post.entry.data.image
    ? { image: new URL(post.entry.data.image, config.site.base_url).href }
    : {}),
};
---

<Base
  lang={lang}
  title={post.title}
  description={post.summary}
  active="articles"
  currentPath={`blog/${post.slug}`}
  noindex={post.sample}
  image={post.entry.data.image || undefined}
  structuredData={structuredData}
  author={post.entry.data.author}
>
  <header class:list={["article-banner", `article-banner--${post.topic.sign}`]}>
    <Awning topics={[post.topic]} class="article-awning" />
    <div class="article-band">
      <div class="article-band-inner">
        <div class="article-band-copy">
          <Signboard
            topic={post.topic}
            lang={lang}
            href={url(lang, `topics/${post.topic.id}`)}
          />
          <h1>{post.title}</h1>
          <p class="article-deck">{post.summary}</p>
          <p class="article-meta">
            {
              meta.map((m, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  {i === 0 ? <a href={url(lang, "about")}>{m}</a> : m}
                </>
              ))
            }
          </p>
          {
            post.tags.length > 0 && (
              <nav class="article-tags" aria-label={c.tagsTitle}>
                {post.tags.map((t) => (
                  <PriceTag text={t} href={url(lang, `tags/${slugify(t)}`)} />
                ))}
              </nav>
            )
          }
        </div>
        <Stamp
          class="article-stamp"
          text={`${stampText} · ${stampText} · `}
          label={minutes}
          center={String(post.minutes)}
        />
      </div>
    </div>
  </header>

  <div class="article-layout">
    <aside class="article-toc">
      <details open data-article-toc>
        <summary>{c.toc}</summary>
        <nav aria-label={c.toc}>
          <ol>
            {
              sections.map((s, i) => (
                <li>
                  <span aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <a href={`#${s.slug}`}>{s.text}</a>
                </li>
              ))
            }
          </ol>
        </nav>
        <p class="toc-total">
          <span>{c.total}</span><span>{shortMinutes(post.minutes, c)}</span>
        </p>
      </details>
    </aside>

    <article class="prose">
      <div class="takeaway">
        <p class="takeaway-label">{c.takeaway}</p>
        <p>{post.takeaway}</p>
      </div>
      <div class="article-body"><Content /></div>

      {
        post.entry.data.references?.length ? (
          <section class="article-sources" aria-labelledby="sources-title">
            <h2 id="sources-title">{c.sources}</h2>
            <ol>
              {post.entry.data.references.map((reference) => (
                <li>
                  <a
                    href={reference.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {reference.label}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ) : null
      }

      <p class="article-disclaimer">{c.articleDisclaimer}</p>

      {
        next && (
          <a class="next-ticket" href={url(lang, `blog/${next.slug}`)}>
            <span class="next-label">{c.next}</span>
            <strong>{next.title}</strong>
            <span class="next-meta">
              {next.topic.name[lang]} · {shortMinutes(next.minutes, c)}{" "}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        )
      }
      <a class="text-link article-back" href={url(lang, "blog")}>← {c.back}</a>
    </article>
  </div>
</Base>

<script>
  const toc = document.querySelector<HTMLDetailsElement>("[data-article-toc]");
  if (toc && window.matchMedia("(max-width: 900px)").matches) toc.open = false;
</script>

<style>
  .article-banner {
    --band: #1e4fa0;
    --band-ink: #ffffff;
    --band-soft: #dbe5f5;
  }
  .article-banner--wave {
    --band: #17676c;
    --band-soft: #d3ebea;
  }
  .article-banner--flame {
    --band: #262422;
    --band-ink: #f4ecdf;
    --band-soft: #cfc6b8;
  }
  .article-banner--bulbs {
    --band: #1f5a3d;
    --band-ink: #fbf1dc;
    --band-soft: #d6e4d9;
  }
  :global([data-theme="dark"]) .article-banner {
    --band: #07142b;
  }
  :global([data-theme="dark"]) .article-banner--wave {
    --band: #041a1c;
  }
  :global([data-theme="dark"]) .article-banner--flame {
    --band: #121110;
  }
  :global([data-theme="dark"]) .article-banner--bulbs {
    --band: #0a1f15;
  }
  .article-banner :global(.article-awning .awning-cornice) {
    display: none;
  }
  .article-band {
    background: var(--band);
    color: var(--band-ink);
  }
  .article-band-inner {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: 1160px;
    margin-inline: auto;
    padding: 36px 40px 48px;
  }
  .article-band-copy {
    flex: 1;
    min-width: 0;
  }
  .article-band h1 {
    margin: 22px 0 14px;
    font: 400 clamp(40px, 5.4vw, 72px) / 1.02 var(--display);
    text-transform: uppercase;
    text-wrap: balance;
  }
  :global(:lang(zh)) .article-band h1 {
    font-weight: 900;
    line-height: 1.2;
  }
  .article-deck {
    max-width: 60ch;
    color: var(--band-soft);
    font-size: 19px;
    line-height: 1.55;
  }
  .article-meta {
    margin-top: 16px;
    color: var(--band-soft);
    font: 600 13px/1.5 var(--mono);
    letter-spacing: 0.04em;
  }
  .article-meta a {
    color: var(--band-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-band :global(:focus-visible) {
    outline-color: var(--mustard);
  }
  .article-band :global(.article-stamp) {
    flex: none;
    width: 150px;
    height: 150px;
    transform: rotate(10deg);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 700px);
    justify-content: center;
    gap: 56px;
    max-width: 1160px;
    margin: 56px auto 0;
    padding-inline: 40px;
  }
  .article-toc details {
    position: sticky;
    top: 110px;
    padding: 20px 20px 16px;
    background: var(--chit);
    color: var(--chit-ink);
    font: 13px/1.5 var(--mono);
    transform: rotate(-1deg);
    filter: drop-shadow(6px 8px 0 rgb(28 23 18 / 0.15));
  }
  .article-toc summary {
    padding-bottom: 12px;
    border-bottom: 2px dashed var(--chit-rule);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .article-toc ol {
    display: grid;
    gap: 10px;
    margin: 14px 0;
    padding: 0;
    list-style: none;
  }
  .article-toc li {
    display: flex;
    gap: 10px;
  }
  .article-toc li span {
    color: #9e1b14;
    font-weight: 600;
  }
  .article-toc a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-toc :focus-visible {
    outline-color: #c8261d;
  }
  .toc-total {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 2px dashed var(--chit-rule);
    font-weight: 600;
  }

  .takeaway {
    margin-bottom: 40px;
    padding: 24px 28px;
    background: var(--red);
    color: var(--on-red);
    box-shadow: 6px 6px 0 var(--shadow);
    font-size: 19px;
    line-height: 1.6;
  }
  .takeaway-label {
    margin-bottom: 8px;
    color: var(--mustard);
    font: 600 13px/1.4 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global([data-theme="dark"]) .takeaway {
    border: 1px solid #6b1a14;
  }

  .article-sources {
    margin-top: 48px;
  }
  .article-sources h2 {
    margin-bottom: 12px;
    font: 400 28px/1.2 var(--display);
    text-transform: uppercase;
  }
  :global(:lang(zh)) .article-sources h2 {
    font-weight: 900;
  }
  .article-sources ol {
    padding-left: 1.4em;
  }
  .article-sources li {
    padding: 4px 0;
  }
  .article-sources a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .article-disclaimer {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--secondary);
    font-size: 13px;
    line-height: 1.6;
  }
  .next-ticket {
    position: relative;
    display: grid;
    gap: 6px;
    margin-top: 40px;
    padding: 24px 28px;
    background: var(--kopi);
    color: var(--on-kopi);
    border-radius: 6px;
    box-shadow: 6px 6px 0 var(--shadow);
    /* Ticket notches. */
    mask:
      radial-gradient(circle 10px at 0 50%, #0000 98%, #000) left / 51% 100%
        no-repeat,
      radial-gradient(circle 10px at 100% 50%, #0000 98%, #000) right / 51% 100%
        no-repeat;
  }
  .next-label {
    color: var(--mustard);
    font: 600 13px/1.4 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global([data-theme="dark"]) .next-label {
    color: var(--color-neon-gold);
  }
  .next-ticket strong {
    font-size: 22px;
    line-height: 1.35;
  }
  .next-ticket:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .next-meta {
    color: #c9d6cc;
    font: 600 13px/1.4 var(--mono);
  }
  .article-back {
    display: inline-block;
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .article-band-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 28px 20px 36px;
    }
    .article-band :global(.article-stamp) {
      width: 110px;
      height: 110px;
    }
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      margin-top: 36px;
      padding-inline: 20px;
    }
    .article-toc details {
      position: static;
      transform: none;
    }
    .article-toc summary {
      display: flex;
      justify-content: space-between;
      border-bottom: 0;
      padding-bottom: 0;
    }
    .article-toc summary::after {
      content: "+";
    }
    .article-toc details[open] summary {
      padding-bottom: 12px;
      border-bottom: 2px dashed var(--chit-rule);
    }
    .article-toc details[open] summary::after {
      content: "−";
    }
  }
</style>
