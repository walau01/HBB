---
import Base from "@/layouts/Base.astro";
import { render } from "astro:content";
import {
  getCopy,
  getPosts,
  topicFor,
  url,
  type Lang,
  type Post,
} from "@/lib/journal";
import config from "@/config/config.json";
const { lang, post } = Astro.props as { lang: Lang; post: Post };
const c = await getCopy(lang),
  p = post.text[lang];
const { Content, headings } = await render(post.entry);
const sections = headings.filter((h) => h.depth === 2);
const others = (await getPosts(lang)).filter((p) => p.slug !== post.slug);
const next = others.find((p) => p.category === post.category) || others[0];
const articleURL = new URL(url(lang, `blog/${post.slug}`), config.site.base_url)
  .href;
const authorURL = new URL(url(lang, "about"), config.site.base_url).href;
const topic = topicFor(post.category);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleURL}#article`,
  url: articleURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": articleURL },
  headline: p.title,
  description: p.summary,
  inLanguage: lang === "zh" ? "zh-Hans" : lang,
  author: {
    "@type": "Person",
    "@id": `${authorURL}#person`,
    name: post.entry.data.author,
    url: authorURL,
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${new URL("/", config.site.base_url).href}#website`,
  },
  ...(post.entry.data.date
    ? { datePublished: post.entry.data.date.toISOString() }
    : {}),
  ...(post.entry.data.image
    ? { image: new URL(post.entry.data.image, config.site.base_url).href }
    : {}),
};
---

<Base
  lang={lang}
  title={p.title}
  description={p.summary}
  active="articles"
  currentPath={`blog/${post.slug}`}
  noindex={post.sample}
  image={post.entry.data.image || undefined}
  structuredData={structuredData}
  author={post.entry.data.author}
>
  <div class="container article-page simple-article">
    <a class="text-link back-link" href={url(lang, "blog")}>{c.back}</a>
    <header class="article-heading">
      <div class="post-meta">
        <a href={url(lang, `topics/${topic}`)}>{c.categories[post.category]}</a
        >{post.sample && <span>{c.draft}</span>}
      </div><h1>{p.title}</h1><p class="article-deck">{p.summary}</p><div
        class="author-line"
      >
        <span class="small-monogram" aria-hidden="true">w.</span><span
          ><strong
            ><a href={url(lang, "about")}>{post.entry.data.author}</a></strong
          ><span>{post.minutes} {c.readTime}</span></span
        >
      </div>
    </header>
    <div class="article-layout">
      <aside class="article-toc">
        <details open data-article-toc>
          <summary>{c.toc}<span aria-hidden="true"> +</span></summary><nav
            aria-label={c.toc}
          >
            {sections.map((s) => <a href={`#${s.slug}`}>{s.text}</a>)}
          </nav>
        </details>{post.sample && <div class="toc-note">{c.sampleNotice}</div>}
      </aside><article class="prose">
        <div class="takeaway">
          <p class="eyebrow">{c.takeaway}</p><p>{p.takeaway}</p>
        </div><div class="article-body"><Content /></div>{
          (post.entry.data.references?.length || post.sample) && (
            <div class="source-box">
              <p class="eyebrow">{c.references}</p>
              {post.entry.data.references ? (
                <>
                  {post.entry.data.references.map((reference) => (
                    <a
                      href={reference.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {reference.label}
                    </a>
                  ))}
                </>
              ) : post.category === "life" ? (
                <p>{c.sampleNotice}</p>
              ) : (
                <>
                  <p>{c.sourceIntro}</p>
                  <a
                    href="https://www.bursamalaysia.com/trade/our_products_services/equities/exchange_traded_funds"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Bursa Malaysia · Exchange Traded Funds
                  </a>
                  <a
                    href="https://www.investor.gov/introduction-investing/investing-basics/investment-products/exchange-traded-funds-etfs"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Investor.gov · Exchange-Traded Funds
                  </a>
                </>
              )}
            </div>
          )
        }<div class="article-end">
          <span class="small-monogram" aria-hidden="true">w.</span><div>
            <strong
              ><a href={url(lang, "about")}>{post.entry.data.author}</a></strong
            ><p>{c.authorBio}</p>
            <a class="text-link" href={url(lang, "about")}>{c.about} →</a>
          </div>
        </div><p class="article-disclaimer">{c.articleDisclaimer}</p>{
          next && (
            <a class="next-article" href={url(lang, `blog/${next.slug}`)}>
              <>
                <span>{c.nextArticle}</span>
                <strong>{next.text[lang].title} →</strong>
              </>
            </a>
          )
        }
      </article>
    </div>
  </div>
  <script>
    const toc =
      document.querySelector<HTMLDetailsElement>("[data-article-toc]");
    if (toc && window.matchMedia("(max-width: 900px)").matches)
      toc.open = false;
  </script>
</Base>
