---
import Base from "@/layouts/Base.astro";
import { getCopy, url, type Lang } from "@/lib/journal";
import { getListPage } from "@/lib/contentParser.astro";
import { render } from "astro:content";
import config from "@/config/config.json";
const { lang } = Astro.props as { lang: Lang };
const c = await getCopy(lang);
const [about] = await getListPage("about", lang);
const { Content } = await render(about);
const profileURL = new URL(url(lang, "about"), config.site.base_url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": profileURL,
  url: profileURL,
  mainEntity: {
    "@type": "Person",
    "@id": `${profileURL}#person`,
    name: config.metadata.meta_author,
    description: c.authorBio,
    url: profileURL,
  },
};
---

<Base
  lang={lang}
  title={c.aboutTitle}
  description={about.data.description}
  active="about"
  currentPath="about"
  structuredData={structuredData}
>
  <div class="page-narrow about-page">
    <header class="about-hero">
      <span class="monogram monogram--large" aria-hidden="true"
        >WALAU<span>01</span></span
      >
      <div>
        <h1 class="page-title">{c.aboutTitle}</h1>
        <p class="about-bio">{about.data.description}</p>
      </div>
    </header>
    <div class="prose">
      <h2 class="about-subtitle">{about.data.title}</h2>
      <div class="article-body"><Content /></div>
    </div>
    <div class="button-row about-links">
      <a class="btn btn-primary" href={url(lang, "start-here")}
        >{c.startTitle} <span aria-hidden="true">→</span></a
      >
      <a class="btn btn-secondary" href={url(lang, "blog")}>{c.boardTitle}</a>
    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .about-hero {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 48px;
  }
  .about-bio {
    margin-top: 12px;
    color: var(--secondary);
    font-size: 20px;
    line-height: 1.55;
  }
  .about-subtitle {
    margin-bottom: 16px;
    font: 400 32px/1.15 var(--display);
    text-transform: uppercase;
  }
  :global(:lang(zh)) .about-subtitle {
    font-weight: 900;
  }
  .about-links {
    margin-top: 40px;
  }
  @media (max-width: 600px) {
    .about-hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>
