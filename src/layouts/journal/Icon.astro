  moon: ['M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z'],
  close: ['M18 6 6 18M6 6l12 12'],
  menu: ['M4 6h16M4 12h16M4 18h16'],
  chevron: ['m9 18 6-6-6-6'],
