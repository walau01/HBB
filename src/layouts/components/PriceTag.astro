---
// Small paper price tag with a string hole.
interface Props {
  text: string;
  href?: string;
  count?: number;
  current?: boolean;
  dataTag?: string;
}
const { text, href, count, current, dataTag } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  class="price-tag"
  href={href}
  aria-current={current ? "page" : undefined}
  data-tag={dataTag}
>
  <span class="price-tag-hole" aria-hidden="true"></span>
  <span>{text}</span>
  {count !== undefined && <span class="price-tag-count">{count}</span>}
</Tag>

<style>
  .price-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    margin-left: 13px;
    padding: 6px 14px 6px 12px;
    border-radius: 0 3px 3px 0;
    background: var(--chit);
    color: var(--chit-ink);
    font: 600 13px/1.2 var(--mono);
    letter-spacing: 0.04em;
    filter: drop-shadow(2px 2px 0 rgb(0 0 0 / 0.15));
    text-decoration: none;
  }
  /* The pointed end. */
  .price-tag::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 25px;
    height: 25px;
    background: inherit;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .price-tag > :not(.price-tag-hole) {
    position: relative;
  }
  .price-tag-hole {
    position: absolute;
    left: -4px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--chit-rule);
  }
  .price-tag-count {
    padding: 1px 6px;
    background: var(--chit-ink);
    color: var(--chit);
    font-size: 11px;
  }
  a.price-tag:hover {
    background: var(--mustard);
    color: var(--mustard-ink);
  }
  a.price-tag[aria-current],
  a.price-tag[aria-pressed="true"] {
    background: var(--red);
    color: var(--on-red);
  }
  :global([data-theme="dark"]) a.price-tag[aria-current] {
    background: var(--mustard);
    color: var(--mustard-ink);
  }
</style>
