---
// The shop row: cornice, rod, one continuous awning, and each topic's sign
// hanging directly below it with its article count. Swipes on phones.
import Awning from "@/layouts/components/Awning.astro";
import Signboard from "@/layouts/components/Signboard.astro";
import { url, type JournalCopy, type Lang, type Post } from "@/lib/journal";
import { articleCount, topicList, type Topic } from "@/lib/topics";

interface Props {
  lang: Lang;
  copy: JournalCopy;
  posts: Post[];
  topics?: Topic[];
  size?: "L" | "S";
  id?: string;
  label?: string;
}
const {
  lang,
  copy: c,
  posts,
  topics = topicList,
  size = "L",
  id,
  label,
} = Astro.props;
const count = (t: Topic) => posts.filter((p) => p.topic.id === t.id).length;
const separator = lang === "zh" ? "，" : ", ";
---

<section
  class:list={["topics-row", `topics-row--${size}`]}
  style={{ "--units": topics.length }}
  id={id}
  aria-label={label || c.topicsLabel}
>
  {label !== "" && <p class="section-label">{label || c.topicsLabel}</p>}
  <div class="topics-scroll">
    <div class="topics-inner">
      <Awning topics={topics} class={size === "S" ? "awning--small" : ""} />
      <ul class="topics-signs">
        {
          topics.map((t) => (
            <li>
              <Signboard
                topic={t}
                lang={lang}
                size={size}
                href={url(lang, `topics/${t.id}`)}
                label={`${t.name[lang]}${separator}${articleCount(count(t), c)}`}
              />
              <span class="topics-count" aria-hidden="true">
                {articleCount(count(t), c)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Each unit is one sign wide plus a small gap, so the signs sit close
     together under one continuous awning. */
  .topics-row {
    --unit: 284px;
    max-width: 1320px;
    margin-inline: auto;
  }
  .topics-row--S {
    --unit: 150px;
  }
  .topics-row .section-label {
    width: min(calc(var(--units) * var(--unit)), 100%);
    margin-inline: auto;
    padding-inline: 15px;
  }
  .topics-scroll {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 14px;
  }
  .topics-inner {
    width: calc(var(--units) * var(--unit));
    margin-inline: auto;
    padding: 0 15px;
    box-sizing: content-box;
  }
  .topics-signs {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topics-signs li {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
    scroll-snap-align: center;
  }
  .topics-count {
    color: var(--ink);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .topics-row--S .topics-count {
    font-size: 13px;
  }
  .topics-row :global(.awning--small .awning-cornice) {
    height: 18px;
  }
  @media (max-width: 700px) {
    .topics-row--L {
      --unit: 80vw;
    }
    .topics-row .section-label {
      width: auto;
      padding-inline: 20px;
    }
  }
</style>
