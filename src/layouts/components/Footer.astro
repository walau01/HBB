---
// Scalloped red footer: tagline, links, giant outlined WALAU01, disclaimer strip.
import config from "@/config/config.json";
import type { JournalCopy } from "@/lib/journal";

interface Props {
  copy: JournalCopy;
  links: { key: string; text: string; href: string }[];
}
const { copy: c, links } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-scallop" aria-hidden="true"></div>
  <div class="footer-top">
    <p class="footer-line">{c.footerLine}</p>
    <nav aria-label={c.footerNav}>
      {links.map((n) => <a href={n.href}>{n.text}</a>)}
    </nav>
  </div>
  <p class="footer-mark" aria-hidden="true" data-neon>WALAU01</p>
  <p class="footer-strip">{config.params.copyright} · {c.footerNote}</p>
</footer>

<style>
  .site-footer {
    margin-top: 72px;
    overflow: hidden;
    background: var(--red);
    color: var(--on-red);
  }
  .footer-scallop {
    height: 17px;
    background-color: var(--paper);
    background-image: radial-gradient(
      circle at 17px 17px,
      var(--red) 16.5px,
      transparent 17px
    );
    background-size: 34px 17px;
    background-repeat: repeat-x;
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: 20px 28px;
    max-width: 1320px;
    margin-inline: auto;
    padding: 44px 40px 0;
  }
  .footer-line {
    font-size: 18px;
    font-weight: 700;
  }
  .footer-top nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global(:lang(zh)) .footer-top nav {
    letter-spacing: 0.12em;
  }
  .footer-top nav a {
    padding-block: 10px;
  }
  .footer-top nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
    text-decoration-color: var(--mustard);
  }
  .footer-top :focus-visible {
    outline: 3px solid var(--mustard);
    outline-offset: 3px;
  }
  .footer-mark {
    margin: 12px 0 -0.16em;
    font:
      400 clamp(96px, 19.5vw, 280px) / 1 var(--font-secondary),
      sans-serif;
    letter-spacing: 0.02em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px var(--on-red);
    user-select: none;
  }
  :global([data-theme="dark"]) .footer-mark {
    -webkit-text-stroke-color: #ffd0d8;
    /* drop-shadow, not text-shadow, so only the outline glows. */
    filter: drop-shadow(0 0 6px var(--color-neon-pink))
      drop-shadow(0 0 18px var(--color-neon-pink));
  }
  .footer-strip {
    position: relative;
    padding: 16px 40px;
    background: var(--red-dark);
    font-size: 13px;
    text-align: center;
  }
  @media (max-width: 650px) {
    .footer-top {
      flex-direction: column;
      padding: 32px 20px 0;
    }
    .footer-top nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      font-size: 14px;
    }
    .footer-mark {
      -webkit-text-stroke-width: 1.5px;
    }
    .footer-strip {
      padding: 14px 20px;
      font-size: 12px;
      text-align: left;
    }
  }
</style>
