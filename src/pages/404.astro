---
import Base from "@/layouts/Base.astro";
import { getCopy, normalizeLang, url } from "@/lib/journal";
const lang = normalizeLang();
const c = await getCopy(lang);
---

<Base lang={lang} title={c.notFound} noindex currentPath="404">
  <div class="container not-found">
    <p class="eyebrow">404</p><h1>{c.notFound}</h1><p>{c.notFoundText}</p><a
      class="button-primary"
      href={url(lang, "blog")}>{c.browse}<span aria-hidden="true"> →</span></a>
  </div>
</Base>
