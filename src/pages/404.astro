---
// A lone unit with its roller shutter down and a paper notice taped on it.
import Base from "@/layouts/Base.astro";
import { getCopy, normalizeLang, url } from "@/lib/journal";
const lang = normalizeLang();
const c = await getCopy(lang);
---

<Base lang={lang} title={c.notFound} noindex currentPath="404">
  <div class="not-found">
    <div class="shutter-unit">
      <div class="shutter-lamp" aria-hidden="true"></div>
      <div class="shutter-box" aria-hidden="true"></div>
      <div class="shutter">
        <div class="shutter-notice">
          <p class="shutter-code" aria-hidden="true">404</p>
          <h1>{c.notFound}</h1>
        </div>
      </div>
      <div class="shutter-floor" aria-hidden="true"></div>
    </div>
    <p class="not-found-text">{c.notFoundText}</p>
    <div class="button-row">
      <a class="btn btn-primary" href={url(lang)}>{c.notFoundButton}</a>
      <a class="text-link" href={url(lang, "blog")}>{c.boardTitle} →</a>
    </div>
  </div>
</Base>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: 28px;
    padding: 64px 20px 32px;
    text-align: center;
  }
  .shutter-unit {
    position: relative;
    width: min(560px, 100%);
  }
  .shutter-box {
    height: 34px;
    background: #6e737a;
    border-radius: 4px 4px 0 0;
  }
  .shutter {
    display: grid;
    place-items: center;
    min-height: 340px;
    padding: 32px 20px;
    background: repeating-linear-gradient(
      #a3a8ae 0 14px,
      #878c93 14px 16px,
      #9aa0a6 16px 18px
    );
    border-inline: 8px solid #6e737a;
  }
  .shutter-notice {
    max-width: 340px;
    padding: 24px 28px;
    background: #f2dfa0;
    color: #1c1712;
    transform: rotate(-2deg);
    box-shadow: 4px 6px 0 rgb(0 0 0 / 0.2);
  }
  /* Tape. */
  .shutter-notice::before {
    content: "";
    display: block;
    width: 90px;
    height: 22px;
    margin: -36px auto 14px;
    background: rgb(255 253 247 / 0.7);
    transform: rotate(3deg);
  }
  .shutter-code {
    font: 600 14px/1 var(--mono);
    letter-spacing: 0.3em;
  }
  .shutter-notice h1 {
    margin-top: 10px;
    font: 400 40px/1.05 var(--display);
    text-transform: uppercase;
  }
  :global(:lang(zh)) .shutter-notice h1 {
    font-weight: 900;
    font-size: 34px;
    line-height: 1.3;
  }
  .shutter-floor {
    height: 10px;
    background: #4a4038;
  }
  .shutter-lamp {
    display: none;
  }
  :global([data-theme="dark"]) .shutter {
    background: repeating-linear-gradient(
      #2a2d33 0 14px,
      #1e2025 14px 16px,
      #25282e 16px 18px
    );
    border-color: #3a3d44;
  }
  :global([data-theme="dark"]) .shutter-box {
    background: #3a3d44;
  }
  :global([data-theme="dark"]) .shutter-notice {
    background: #c9c2b2;
  }
  /* Night: a single street lamp glows on the shutter. */
  :global([data-theme="dark"]) .shutter-lamp {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 60% 55% at 50% 30%,
      rgb(255 214 140 / 0.28),
      transparent 70%
    );
  }
  .not-found-text {
    color: var(--secondary);
    font-size: 19px;
  }
  .not-found .button-row {
    justify-content: center;
    align-items: center;
  }
</style>
