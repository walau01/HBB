---
import Article from '@/layouts/journal/Article.astro';
import {supportedLang} from '@/lib/utils/languageParser';
import {getPosts,normalizeLang} from '@/lib/journal';
export async function getStaticPaths() {
  return (await Promise.all(supportedLang.map(async lang => (await getPosts(normalizeLang(lang))).map(post => ({params:{lang:lang||undefined,single:post.slug},props:{post}}))))).flat();
}
const lang=normalizeLang(Astro.params.lang);
const {post}=Astro.props;
---
<Article lang={lang} post={post}/>
