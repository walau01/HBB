---
import About from "@/layouts/journal/About.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { supportedLang } from "@/lib/utils/languageParser";
import { normalizeLang } from "@/lib/journal";
export async function getStaticPaths() {
  return (
    await Promise.all(
      supportedLang.map(async (lang) =>
        (await getSinglePage("authors", lang)).map((author) => ({
          params: {
            lang: lang || undefined,
            single: author.id.split("/").pop(),
          },
        })),
      ),
    )
  ).flat();
}
const lang = normalizeLang(Astro.params.lang);
---

<About lang={lang} />
