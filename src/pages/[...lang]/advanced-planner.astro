---
import Base from "@/layouts/Base.astro";
import CoastFire from "@/layouts/components/CoastFire";
import "@/styles/coast-fire.css";
import { getTranslations, supportedLang } from "@/lib/utils/languageParser";
import { normalizeLang, url } from "@/lib/journal";
export function getStaticPaths() {
  return supportedLang.map((lang) => ({ params: { lang: lang || undefined } }));
}
const lang = normalizeLang(Astro.params.lang);
const { coast, simpleCoast } = await getTranslations(lang);
---

<Base
  lang={lang}
  title={simpleCoast.advancedTitle}
  description={coast.intro}
  active="coast"
  currentPath="advanced-planner"
>
  <div class="container planner-back">
    <a class="text-link" href={url(lang, "coast-fire")}>{simpleCoast.back}</a>
  </div>
  <CoastFire
    copy={{ ...coast, title: simpleCoast.advancedTitle }}
    lang={lang}
    journalHref={url(lang)}
    client:load
  />
</Base>
