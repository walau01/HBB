---
import Archive from "@/layouts/journal/Archive.astro";
import { getCopy, getPosts, normalizeLang } from "@/lib/journal";
import { supportedLang } from "@/lib/utils/languageParser";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { slugify } from "@/lib/utils/textConverter";
export async function getStaticPaths() {
  return (
    await Promise.all(
      supportedLang.map(async (lang) =>
        (await getTaxonomy(normalizeLang(lang), "categories")).map((value) => ({
          params: { lang: lang || undefined, category: value },
        })),
      ),
    )
  ).flat();
}
const lang = normalizeLang(Astro.params.lang);
const c = await getCopy(lang);
const posts = (await getPosts(lang)).filter((p) =>
  p.entry.data.categories.some(
    (label) => slugify(label) === Astro.params.category,
  ),
);
const title =
  posts[0]?.entry.data.categories.find(
    (label) => slugify(label) === Astro.params.category,
  ) || Astro.params.category!;
---

<Archive
  lang={lang}
  selectedPosts={posts}
  heading={title}
  description={c.taxonomyDescription.replace("{topic}", title)}
  currentPath={`categories/${Astro.params.category}`}
  legacy
/>
