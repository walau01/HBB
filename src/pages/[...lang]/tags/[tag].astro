---
import Archive from "@/layouts/journal/Archive.astro";
import { getPosts, normalizeLang } from "@/lib/journal";
import { supportedLang } from "@/lib/utils/languageParser";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { slugify } from "@/lib/utils/textConverter";
export async function getStaticPaths() {
  return (
    await Promise.all(
      supportedLang.map(async (lang) =>
        (await getTaxonomy(normalizeLang(lang))).map((value) => ({
          params: { lang: lang || undefined, tag: value },
        })),
      ),
    )
  ).flat();
}
const lang = normalizeLang(Astro.params.lang);
const slug = Astro.params.tag!;
const posts = (await getPosts(lang)).filter((p) =>
  p.tags.some((label) => slugify(label) === slug),
);
const label = posts[0]?.tags.find((t) => slugify(t) === slug) || slug;
---

<Archive lang={lang} tag={{ slug, label, posts }} />
