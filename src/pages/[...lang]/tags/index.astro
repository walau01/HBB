---
import TaxonomyIndex from "@/layouts/journal/TaxonomyIndex.astro";
import { supportedLang } from "@/lib/utils/languageParser";
import { normalizeLang } from "@/lib/journal";
export function getStaticPaths() {
  return supportedLang.map((lang) => ({ params: { lang: lang || undefined } }));
}
const lang = normalizeLang(Astro.params.lang);
---

<TaxonomyIndex lang={lang} taxonomy="tags" />
