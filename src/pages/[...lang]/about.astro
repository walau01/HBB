---
import About from '@/layouts/journal/About.astro';
import {supportedLang} from '@/lib/utils/languageParser';
import {normalizeLang} from '@/lib/journal';
export function getStaticPaths() {return supportedLang.map(lang=>({params:{lang:lang||undefined}}));}
const lang=normalizeLang(Astro.params.lang);
---
<About lang={lang}/>
