---
import TopicPage from "@/layouts/journal/TopicPage.astro";
import { supportedLang } from "@/lib/utils/languageParser";
import { normalizeLang } from "@/lib/journal";
import { topicList } from "@/lib/topics";
export function getStaticPaths() {
  return supportedLang.flatMap((lang) =>
    topicList.map((topic) => ({
      params: { lang: lang || undefined, topic: topic.id },
      props: { topic },
    })),
  );
}
const { topic } = Astro.props;
const lang = normalizeLang(Astro.params.lang);
---

<TopicPage lang={lang} topic={topic} />
